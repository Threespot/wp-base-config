{
    "name": "threespot/wp-base-config",
    "description": "Reusable WordPress mu-plugin modules and helper functions shared across Threespot sites.",
    "type": "library",
    "license": "proprietary",
    "homepage": "https://github.com/threespot/wp-base-config",
    "authors": [
        {
            "name": "Threespot",
            "homepage": "https://threespot.com"
        }
    ],
    "require": {
        "php": ">=8.1",
        "log1x/navi": "^3.0"
    },
    "require-dev": {
        "brain/monkey": "^2.6",
        "phpunit/phpunit": "^10.5 || ^11.0"
    },
    "autoload": {
        "psr-4": {
            "Threespot\\Wp\\MuPlugins\\": "src/MuPlugins/"
        },
        "files": [
            "src/Helpers/author.php",
            "src/Helpers/general.php",
            "src/Helpers/image.php",
            "src/Helpers/menu.php",
            "src/Helpers/svg.php",
            "src/Helpers/taxonomy.php",
            "src/PublicApi/functions.php",
            "src/Sage/assets.php",
            "src/Sage/blade.php",
            "src/Sage/prettify.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Threespot\\Wp\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable"
}
